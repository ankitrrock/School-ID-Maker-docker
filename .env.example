PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_id_maker
# Docker generates and persists a signing secret when this is empty.
# Local npm start requires an explicit random secret of at least 32 characters.
JWT_SECRET=
ADMIN_EMAIL=

# Supabase Storage (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=id-card-assets

# Future online billing - intentionally unused while COD/manual activation is enabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

FREE_STUDENT_LIMIT=50
FREE_CARD_LIMIT=50
PRO_STUDENT_LIMIT=5000
PRO_CARD_LIMIT=5000

# Set NODE_ENV=production behind HTTPS. Set proxy hops only for a trusted proxy.
TRUST_PROXY_HOPS=0
