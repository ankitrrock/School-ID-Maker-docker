# PostgreSQL
DATABASE_URL=postgresql://postgres:root@localhost:5432/school_id_maker

# JWT signing secret: use a random value of at least 32 characters
JWT_SECRET=school_id_maker_local_jwt_secret_2026_change_this

# Frontend origins, comma separated
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Optional SMTP for production password-reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=School ID Maker <no-reply@example.com>
